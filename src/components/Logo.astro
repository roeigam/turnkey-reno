---
/**
 * The single place the logo is rendered. Files come from brand.logo in src/data/site.ts.
 *
 * Sizing: constrained by HEIGHT (set via `class`, e.g. "h-10") with width auto and
 * a max-width cap, so wide and square variants both fit without breaking layouts.
 */
import { Image } from 'astro:assets';
import { brand } from '../data/site';
import { asset } from '../lib/images';

type Variant = 'full' | 'compact' | 'lockup' | 'icon';

interface Props {
  variant?: Variant;
  /** Background the logo sits on. */
  tone?: 'dark' | 'light';
  class?: string;
  maxWidth?: string;
  eager?: boolean;
}

const { variant = 'full', tone = 'dark', class: className = 'h-10', maxWidth = 'max-w-full', eager = false } = Astro.props;
const logo = asset(brand.logo[variant][tone]);
---

<Image
  src={logo}
  alt={brand.logo.alt}
  class:list={['block w-auto object-contain object-left', className, maxWidth]}
  loading={eager ? 'eager' : 'lazy'}
/>
