---
/**
 * The single place the logo is rendered (header + footer).
 * The file comes from brand.logo.src in src/data/site.ts.
 *
 * Sizing: the logo is constrained by HEIGHT (set via `class`, e.g. "h-10") with
 * width auto and a max-width cap, so both wide wordmarks and square marks fit
 * without breaking the header layout.
 */
import { Image } from 'astro:assets';
import { brand, company } from '../data/site';
import { asset } from '../lib/images';

interface Props {
  class?: string;
  /** Max width for wide logos. */
  maxWidth?: string;
  eager?: boolean;
}

const { class: className = 'h-10', maxWidth = 'max-w-[13rem]', eager = false } = Astro.props;
const logo = asset(brand.logo.src);
---

<span class:list={['flex min-w-0 items-center gap-3', className]}>
  <Image
    src={logo}
    alt={brand.logo.showNameNextToLogo ? '' : brand.logo.alt}
    class:list={['h-full w-auto object-contain object-left', maxWidth]}
    loading={eager ? 'eager' : 'lazy'}
  />
  {
    brand.logo.showNameNextToLogo && (
      <span class="truncate font-display text-2xl leading-none font-bold tracking-wide text-white uppercase">
        {company.name}
      </span>
    )
  }
</span>
