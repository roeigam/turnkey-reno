---
/** Small "Placeholder" tag, shown only when settings.showPlaceholderBadges is on. */
import { settings } from '../data/site';

interface Props {
  /** Must be true for the badge to render (pass the item's `placeholder` flag). */
  show?: boolean;
  dark?: boolean;
  class?: string;
}

const { show = false, dark = false, class: className } = Astro.props;
---

{
  settings.showPlaceholderBadges && show && (
    <span class:list={['placeholder-badge', dark && 'is-dark', className]}>Placeholder</span>
  )
}
