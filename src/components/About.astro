---
import { about, company } from '../data/site';
import AngleDivider from './AngleDivider.astro';
import Icon from './Icon.astro';

const [lead, ...rest] = about.paragraphs;
---

<section
  id="about"
  aria-labelledby="about-heading"
  class="on-dark relative isolate overflow-hidden bg-navy-900 pt-[calc(clamp(1.75rem,4vw,4rem)+5rem)] pb-24 text-white sm:pb-28 lg:pt-[calc(4rem+7rem)] lg:pb-36"
>
  <AngleDivider fill="text-paper" />
  <div class="absolute inset-0 -z-10 bg-blueprint [mask-image:radial-gradient(ellipse_at_20%_40%,black,transparent_75%)]"></div>
  <!-- Oversized outlined word as a quiet backdrop -->
  {
    about.watermark && (
      <p
        class="pointer-events-none absolute -right-6 bottom-6 -z-10 hidden font-display text-[16rem] leading-none font-bold tracking-tight whitespace-nowrap text-transparent uppercase select-none [-webkit-text-stroke:1px_rgb(255_255_255/0.07)] lg:block"
        aria-hidden="true"
      >
        {about.watermark}
      </p>
    )
  }

  <div class="container-site grid gap-14 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5" data-reveal>
      <p class="eyebrow text-accent">{about.eyebrow}</p>
      <h2 id="about-heading" class="mt-4 font-display text-[2.9rem] leading-[0.92] font-bold tracking-tight uppercase sm:text-6xl lg:text-7xl">
        {about.heading}
      </h2>

      <div class="mt-10 hidden border-l-2 border-accent pl-6 lg:block">
        <p class="font-display text-sm font-semibold tracking-[0.18em] text-slate-400 uppercase">{about.ctaText}</p>
        <a href={`tel:${company.phoneE164}`} class="mt-1 inline-flex items-center gap-3 font-display text-4xl font-bold tracking-wide transition-colors hover:text-accent">
          <Icon name="phone" class="size-7 text-accent" />
          {company.phoneDisplay}
        </a>
      </div>
    </div>

    <div class="lg:col-span-7 lg:pt-12">
      <div data-reveal style="--reveal-delay: 100ms">
        <p class="text-xl leading-relaxed text-white sm:text-[1.375rem] sm:leading-[1.6]">{lead}</p>
        {rest.map((p) => <p class="mt-6 text-lg leading-relaxed text-slate-300">{p}</p>)}
      </div>

      <ul class="mt-12 grid gap-x-10 sm:grid-cols-2" role="list">
        {
          about.values.map((value, i) => (
            <li class="flex gap-4 border-t border-white/10 py-6" data-reveal style={`--reveal-delay: ${120 + i * 70}ms`}>
              <span class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-full bg-accent text-navy-950">
                <Icon name="check" class="size-4" strokeWidth={3} />
              </span>
              <div>
                <h3 class="font-display text-xl font-bold tracking-wide uppercase">{value.title}</h3>
                <p class="mt-1 text-slate-400">{value.text}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:hidden" data-reveal>
        <a href={`tel:${company.phoneE164}`} class="btn btn-ghost-light">
          <Icon name="phone" />
          {company.phoneDisplay}
        </a>
        <a href="#estimate" class="btn btn-primary">Get a Free Estimate</a>
      </div>
    </div>
  </div>
</section>
