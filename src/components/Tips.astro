---
import { tips, tipsIntro } from '../data/site';
import AngleDivider from './AngleDivider.astro';
import Icon from './Icon.astro';
import PlaceholderBadge from './PlaceholderBadge.astro';
import SectionHeading from './SectionHeading.astro';
---

<section
  id="tips"
  aria-labelledby="tips-heading"
  class="relative isolate overflow-hidden bg-navy-950 pt-[calc(clamp(1.75rem,4vw,4rem)+5rem)] pb-24 text-white sm:pb-28 lg:pt-[calc(4rem+7rem)] lg:pb-36"
>
  <AngleDivider fill="text-white" flip />
  <div class="absolute inset-0 -z-10 bg-blueprint [mask-image:radial-gradient(ellipse_at_85%_20%,black,transparent_70%)]"></div>

  <div class="container-site">
    <div class="flex items-end justify-between gap-8">
      <SectionHeading id="tips-heading" eyebrow={tipsIntro.eyebrow} heading={tipsIntro.heading} text={tipsIntro.text} dark />
      <span class="hidden size-24 shrink-0 place-items-center rounded-full text-accent ring-1 ring-accent/40 lg:grid" aria-hidden="true">
        <Icon name="bulb" class="size-10" strokeWidth={1.5} />
      </span>
    </div>

    <ol class="mt-14 grid gap-px overflow-hidden rounded-[4px] bg-white/10 md:grid-cols-3 lg:mt-16" role="list">
      {
        tips.map((tip, i) => (
          <li class="group relative bg-navy-950 p-7 transition-colors duration-300 hover:bg-navy-900 sm:p-9" data-reveal style={`--reveal-delay: ${i * 100}ms`}>
            <div class="flex items-baseline justify-between gap-4">
              <p class="font-display text-sm font-semibold tracking-[0.22em] text-accent uppercase">Tip {String(i + 1).padStart(2, '0')}</p>
              <PlaceholderBadge show={tip.placeholder} dark />
            </div>
            <h3 class="mt-6 font-display text-[1.75rem] leading-[1.05] font-bold tracking-wide uppercase">{tip.title}</h3>
            <p class="mt-4 leading-relaxed text-slate-400">{tip.body}</p>
            <span class="absolute bottom-0 left-0 h-[3px] w-10 bg-accent transition-all duration-500 ease-out group-hover:w-full" />
          </li>
        ))
      }
    </ol>
  </div>
</section>
