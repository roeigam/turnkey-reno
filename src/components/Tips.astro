---
import { tips, tipsIntro } from '../data/site';
import AngleDivider from './AngleDivider.astro';
import Icon from './Icon.astro';
import PlaceholderBadge from './PlaceholderBadge.astro';
import SectionHeading from './SectionHeading.astro';
---

<section
  id="tips"
  aria-labelledby="tips-heading"
  class="on-dark relative isolate overflow-hidden bg-navy-950 pt-[calc(clamp(1.75rem,4vw,4rem)+5rem)] pb-24 text-white sm:pb-28 lg:pt-[calc(4rem+7rem)] lg:pb-36"
>
  <AngleDivider fill="text-white" flip />
  <div class="absolute inset-0 -z-10 bg-blueprint [mask-image:radial-gradient(ellipse_at_85%_20%,black,transparent_70%)]"></div>

  <div class="container-site">
    <div class="flex items-end justify-between gap-8">
      <SectionHeading id="tips-heading" eyebrow={tipsIntro.eyebrow} heading={tipsIntro.heading} text={tipsIntro.text} dark />
      <span class="hidden size-24 shrink-0 place-items-center rounded-full text-accent ring-1 ring-accent/40 lg:grid" aria-hidden="true">
        <Icon name="bulb" class="size-10" strokeWidth={1.5} />
      </span>
    </div>

    <!-- 3 × 2 on desktop, 2 columns on tablet, 1 column on mobile -->
    <ol class="mt-12 grid gap-px overflow-hidden rounded-[4px] bg-white/10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3" role="list">
      {
        tips.map((tip, i) => (
          <li class="group relative flex flex-col bg-navy-950 px-5 py-6 transition-colors duration-300 hover:bg-navy-900 sm:p-8" data-reveal style={`--reveal-delay: ${(i % 3) * 90}ms`}>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <p class="font-display text-sm font-semibold tracking-[0.22em] text-accent uppercase">Tip {String(i + 1).padStart(2, '0')}</p>
              <!-- Category tag: square outline label, distinct from the rounded amber placeholder badge -->
              <span class="rounded-[2px] border border-white/20 px-2 py-0.5 font-display text-xs font-semibold tracking-[0.16em] text-slate-300 uppercase">
                {tip.tag}
              </span>
            </div>
            <h3 class="mt-3 font-display text-[1.375rem] leading-[1.05] font-bold tracking-wide uppercase sm:mt-6 sm:text-[1.75rem]">{tip.title}</h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-slate-400 sm:mt-4 sm:text-base">{tip.body}</p>
            <PlaceholderBadge show={tip.placeholder} dark class="mt-4 self-start" />
            <span class="absolute bottom-0 left-0 h-[3px] w-10 bg-accent transition-all duration-500 ease-out group-hover:w-full" />
          </li>
        ))
      }
    </ol>
  </div>
</section>
