---
/**
 * Before/after comparison slider for photos taken from the same angle.
 *
 * - The after photo is underneath; the before photo is on top, clipped at --pos.
 * - Keyboard: a native <input type="range"> (visually hidden, focusable) gives
 *   arrow keys, Home/End and Page Up/Down, and screen readers announce it as a slider.
 * - Mouse/touch: pointer events on the media area set the same range value.
 *   `touch-action: pan-y` keeps vertical page scrolling working on phones.
 * - No animation; the knob's hover scale is disabled under prefers-reduced-motion.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Shot {
  meta: ImageMetadata;
  alt: string;
}
interface Props {
  before: Shot;
  after: Shot;
  /** Accessible name, e.g. the project title. */
  label: string;
  sizes: string;
  class?: string;
}

const { before, after, label, sizes, class: className } = Astro.props;
const widths = (m: ImageMetadata) => [480, 800, 1200].filter((w) => w <= m.width).concat(m.width < 480 ? [m.width] : []);
---

<div
  class:list={['group relative isolate cursor-ew-resize touch-pan-y overflow-hidden bg-navy-950 select-none', className]}
  style="--pos: 50%"
  data-ba
>
  <Image src={after.meta} alt={after.alt} widths={widths(after.meta)} sizes={sizes} class="absolute inset-0 size-full object-cover" draggable="false" />
  <div class="absolute inset-0 [clip-path:inset(0_calc(100%-var(--pos))_0_0)]" data-ba-before>
    <Image src={before.meta} alt={before.alt} widths={widths(before.meta)} sizes={sizes} class="size-full object-cover" draggable="false" />
  </div>

  <span class="pointer-events-none absolute top-3 left-3 z-10 rounded-[2px] bg-navy-950/85 px-2.5 py-1 font-display text-xs font-semibold tracking-[0.16em] text-white uppercase sm:top-4 sm:left-4 sm:text-sm">Before</span>
  <span class="pointer-events-none absolute top-3 right-3 z-10 rounded-[2px] bg-accent px-2.5 py-1 font-display text-xs font-semibold tracking-[0.16em] text-navy-950 uppercase sm:top-4 sm:right-4 sm:text-sm">After</span>

  <input
    type="range"
    min="0"
    max="100"
    step="1"
    value="50"
    class="sr-only"
    aria-label={`Before and after comparison: ${label}. Use the arrow keys to compare.`}
    aria-valuetext="50% before, 50% after"
    data-ba-input
  />

  <!-- Handle: gold line + knob, follows --pos; ring shows while the range has keyboard focus (data-focus) -->
  <div class="pointer-events-none absolute inset-y-0 z-10 w-0 left-(--pos)" aria-hidden="true">
    <span class="absolute inset-y-0 -left-px w-0.5 bg-accent shadow-[0_0_0_1px_rgb(7_14_26/0.25)]"></span>
    <span
      class="absolute top-1/2 left-0 grid size-11 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-accent text-navy-950 shadow-[0_6px_18px_-4px_rgb(0_0_0/0.55)] ring-offset-2 ring-offset-navy-950 group-data-focus:ring-4 group-data-focus:ring-white motion-safe:transition-transform"
      data-ba-knob
    >
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
        <path d="m9 7-5 5 5 5M15 7l5 5-5 5"></path>
      </svg>
    </span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('[data-ba-input]')!;
    const knob = root.querySelector<HTMLElement>('[data-ba-knob]')!;

    const apply = (v: number) => {
      const value = Math.max(0, Math.min(100, Math.round(v)));
      input.value = String(value);
      root.style.setProperty('--pos', `${value}%`);
      input.setAttribute('aria-valuetext', `${value}% before, ${100 - value}% after`);
    };
    input.addEventListener('input', () => apply(Number(input.value)));
    // Visible focus ring on the knob only for keyboard focus.
    input.addEventListener('focus', () => root.toggleAttribute('data-focus', input.matches(':focus-visible')));
    input.addEventListener('blur', () => root.removeAttribute('data-focus'));

    // Mouse / pen / touch: map the pointer's x position to the slider value.
    const fromPointer = (e: PointerEvent) => {
      const r = root.getBoundingClientRect();
      apply(((e.clientX - r.left) / r.width) * 100);
    };
    let dragging = false;
    root.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      dragging = true;
      root.setPointerCapture(e.pointerId);
      fromPointer(e);
      input.focus({ preventScroll: true });
      knob.style.scale = '1.08';
    });
    root.addEventListener('pointermove', (e) => dragging && fromPointer(e));
    const stop = () => {
      dragging = false;
      knob.style.scale = '';
    };
    root.addEventListener('pointerup', stop);
    root.addEventListener('pointercancel', stop); // e.g. the browser took over for vertical scrolling
  });
</script>
