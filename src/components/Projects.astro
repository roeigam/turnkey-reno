---
/**
 * Projects gallery: before/after cards, comparison slider (BeforeAfterSlider.astro) and lightbox.
 * Re-enable only with photos of Turnkey Reno's own completed projects (settings.showProjects).
 */
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import { projectCaption, projects, projectsIntro, type ProjectImage } from '../data/site';
import { asset } from '../lib/images';
import BeforeAfterSlider from './BeforeAfterSlider.astro';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const enabled = projects.filter((p) => p.enabled !== false);
const featured = enabled.find((p) => p.featured) ?? enabled[0];
const ordered = featured ? [featured, ...enabled.filter((p) => p !== featured)] : [];

interface Shot {
  meta: ImageMetadata;
  alt: string;
  full: string;
}
const load = async (img: ProjectImage): Promise<Shot> => {
  const meta = asset(img.src);
  // Lightbox version: up to 2000px wide, never upscaled (raster → WebP).
  const full = await getImage({ src: meta, width: Math.min(meta.width, 2000) });
  return { meta, alt: img.alt, full: full.src };
};

const cards = await Promise.all(
  ordered.map(async (p) => ({
    project: p,
    caption: projectCaption(p),
    before: await Promise.all(p.before.map(load)),
    after: await Promise.all(p.after.map(load)),
  })),
);

// Lightbox data: per project, befores then afters, each labelled.
const slides = cards.map((c) => ({
  title: c.project.title,
  caption: c.caption,
  items: [
    ...c.before.map((s) => ({ src: s.full, alt: s.alt, label: 'Before' })),
    ...c.after.map((s) => ({ src: s.full, alt: s.alt, label: 'After' })),
  ],
}));

// Desktop: the featured card spans the full width; the others share the row below evenly.
const spans: Record<number, string> = { 1: 'lg:col-span-12', 2: 'lg:col-span-6', 3: 'lg:col-span-4', 4: 'lg:col-span-3' };
const restSpan = spans[cards.length - 1] ?? 'lg:col-span-4';
const widths = (m: ImageMetadata) => [400, 640, 960].filter((w) => w < m.width).concat(m.width);
const chip = 'pointer-events-none absolute top-3 z-10 rounded-[2px] px-2.5 py-1 font-display text-xs font-semibold tracking-[0.16em] uppercase';
---

<section id="projects" aria-labelledby="projects-heading" class="bg-white py-24 sm:py-28 lg:py-36">
  <div class="container-site">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeading id="projects-heading" eyebrow={projectsIntro.eyebrow} heading={projectsIntro.heading} text={projectsIntro.text} />
      <a href="#estimate" class="btn btn-dark self-start lg:self-end" data-reveal>
        Start Your Project
        <Icon name="arrow" class="btn-arrow" />
      </a>
    </div>

    <ul class="mt-12 grid gap-5 sm:gap-6 lg:mt-16 lg:grid-cols-12" role="list">
      {
        cards.map((c, i) => {
          const isFeatured = i === 0;
          const total = c.before.length + c.after.length;
          const openLabel = `View all ${total} photos: ${c.project.title}`;
          return (
            <li class:list={['flex', isFeatured ? 'lg:col-span-12' : restSpan]} data-reveal style={`--reveal-delay: ${i * 80}ms`}>
              <article class="flex w-full flex-col overflow-hidden rounded-[4px] bg-navy-950 shadow-[0_24px_50px_-28px_rgb(7_14_26/0.55)] ring-1 ring-navy-900/10">
                {c.project.matchedPair ? (
                  <BeforeAfterSlider
                    before={c.before[0]}
                    after={c.after[0]}
                    label={c.project.title}
                    sizes={isFeatured ? '(min-width: 1280px) 75rem, 100vw' : '(min-width: 1280px) 24rem, (min-width: 1024px) 31vw, 100vw'}
                    class:list={['w-full', isFeatured ? 'aspect-[4/3] sm:aspect-[16/10] lg:aspect-[2/1]' : 'aspect-[5/4] sm:aspect-[16/10] lg:aspect-auto lg:min-h-[18rem] lg:flex-1']}
                  />
                ) : (
                  <button
                    type="button"
                    class:list={[
                      'group relative grid w-full grid-cols-2 gap-0.5 bg-navy-950 text-left',
                      isFeatured ? 'aspect-[5/4] sm:aspect-[16/10] lg:aspect-[2/1]' : 'aspect-[4/3] sm:aspect-[16/10] lg:aspect-auto lg:min-h-[18rem] lg:flex-1',
                    ]}
                    data-open-project={i}
                    aria-label={openLabel}
                    aria-haspopup="dialog"
                  >
                    {[c.before[0], c.after[0]].map((shot, k) => (
                      <span class="relative overflow-hidden">
                        <Image
                          src={shot.meta}
                          alt={shot.alt}
                          widths={widths(shot.meta)}
                          sizes={isFeatured ? '(min-width: 1280px) 37.5rem, 50vw' : '(min-width: 1280px) 12rem, (min-width: 1024px) 16vw, 50vw'}
                          class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                        />
                        <span class:list={[chip, k === 0 ? 'left-3 bg-navy-950/85 text-white' : 'right-3 bg-accent text-navy-950']}>
                          {k === 0 ? 'Before' : 'After'}
                        </span>
                      </span>
                    ))}
                    <span class="pointer-events-none absolute bottom-3 left-1/2 grid size-10 -translate-x-1/2 place-items-center rounded-full bg-accent text-navy-950 opacity-0 shadow-lg transition duration-300 group-hover:opacity-100 group-focus-visible:opacity-100">
                      <Icon name="expand" class="size-[18px]" strokeWidth={2} />
                    </span>
                  </button>
                )}

                {/* Small cards: room for a two-line title, so the gold rules line up across the row */}
                <div class:list={['flex items-center justify-between gap-4 border-t-2 border-accent px-5 py-4 text-white sm:px-6', !isFeatured && 'lg:min-h-[6.75rem]']}>
                  <div class="min-w-0">
                    <p class="font-display text-xs font-semibold tracking-[0.2em] text-accent uppercase sm:text-sm">{c.caption}</p>
                    <h3
                      class:list={[
                        'mt-0.5 font-display text-xl leading-tight font-bold tracking-wide uppercase sm:text-2xl',
                        isFeatured ? 'lg:text-3xl' : 'lg:text-xl',
                      ]}
                    >
                      {c.project.title}
                    </h3>
                  </div>
                  <button
                    type="button"
                    class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-[3px] px-3 font-display text-sm font-semibold tracking-[0.12em] text-white uppercase ring-1 ring-white/25 transition ring-inset hover:bg-white/10 hover:ring-white/60"
                    data-open-project={i}
                    aria-label={openLabel}
                    aria-haspopup="dialog"
                  >
                    <Icon name="expand" class="size-4 text-accent" strokeWidth={2} />
                    Photos ({total})
                  </button>
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>
  </div>

  <script type="application/json" id="project-slides" set:html={JSON.stringify(slides)} />

  <!-- Lightbox -->
  <dialog
    id="lightbox"
    class="on-dark lightbox m-auto h-dvh max-h-none w-screen max-w-none bg-transparent p-0 text-white"
    aria-label="Project photo viewer"
  >
    <div class="flex h-full flex-col">
      <div class="flex items-center justify-between gap-4 px-4 py-3 sm:px-6 sm:py-4">
        <p class="font-display text-sm font-semibold tracking-[0.2em] text-slate-400 uppercase tabular-nums" aria-live="polite">
          <span data-lb-counter></span>
        </p>
        <button type="button" class="grid size-12 place-items-center rounded-full bg-white/10 transition hover:bg-white/20" data-lb-close aria-label="Close">
          <Icon name="close" class="size-6" />
        </button>
      </div>

      <figure class="relative flex min-h-0 flex-1 flex-col items-center justify-center px-4 sm:px-20">
        <div class="relative flex min-h-0 max-w-full flex-1 items-center justify-center">
          <img data-lb-img src="" alt="" class="max-h-full min-h-0 w-auto max-w-full rounded-[3px] object-contain shadow-2xl" />
        </div>
        <figcaption class="mt-4 mb-2 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-center">
          <span data-lb-label class="rounded-[2px] px-2.5 py-1 font-display text-sm font-semibold tracking-[0.16em] uppercase"></span>
          <span class="font-display text-lg font-bold tracking-wider uppercase sm:text-xl" data-lb-title></span>
          <span class="text-sm text-slate-400" data-lb-caption></span>
        </figcaption>

        <button
          type="button"
          class="absolute top-1/2 left-2 hidden size-12 -translate-y-1/2 place-items-center rounded-full bg-white/10 transition hover:bg-accent hover:text-navy-950 sm:left-5 sm:grid"
          data-lb-prev
          aria-label="Previous photo"
        >
          <Icon name="chevronLeft" class="size-6" strokeWidth={2.25} />
        </button>
        <button
          type="button"
          class="absolute top-1/2 right-2 hidden size-12 -translate-y-1/2 place-items-center rounded-full bg-white/10 transition hover:bg-accent hover:text-navy-950 sm:right-5 sm:grid"
          data-lb-next
          aria-label="Next photo"
        >
          <Icon name="chevronRight" class="size-6" strokeWidth={2.25} />
        </button>
      </figure>

      <!-- Mobile prev/next row -->
      <div class="flex justify-center gap-4 px-4 pt-2 pb-[calc(1rem+env(safe-area-inset-bottom))] sm:hidden">
        <button type="button" class="grid size-12 place-items-center rounded-full bg-white/10" data-lb-prev aria-label="Previous photo">
          <Icon name="chevronLeft" class="size-6" strokeWidth={2.25} />
        </button>
        <button type="button" class="grid size-12 place-items-center rounded-full bg-white/10" data-lb-next aria-label="Next photo">
          <Icon name="chevronRight" class="size-6" strokeWidth={2.25} />
        </button>
      </div>
    </div>
  </dialog>
</section>

<script>
  interface Slide {
    src: string;
    alt: string;
    label: 'Before' | 'After';
  }
  interface ProjectSlides {
    title: string;
    caption: string;
    items: Slide[];
  }

  const data: ProjectSlides[] = JSON.parse(document.getElementById('project-slides')!.textContent || '[]');
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const label = dialog.querySelector<HTMLElement>('[data-lb-label]')!;
  const title = dialog.querySelector<HTMLElement>('[data-lb-title]')!;
  const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
  const counter = dialog.querySelector<HTMLElement>('[data-lb-counter]')!;
  let project = 0;
  let index = 0;
  let opener: HTMLElement | null = null;

  const show = (i: number) => {
    const items = data[project].items;
    index = (i + items.length) % items.length;
    const s = items[index];
    img.src = s.src;
    img.alt = s.alt;
    label.textContent = s.label;
    label.className =
      'rounded-[2px] px-2.5 py-1 font-display text-sm font-semibold tracking-[0.16em] uppercase ' +
      (s.label === 'After' ? 'bg-accent text-navy-950' : 'bg-white/15 text-white');
    title.textContent = data[project].title;
    caption.textContent = data[project].caption;
    counter.textContent = `${index + 1} / ${items.length}`;
    // Warm the cache for neighbours.
    [index - 1, index + 1].forEach((n) => {
      new Image().src = items[(n + items.length) % items.length].src;
    });
  };

  document.querySelectorAll<HTMLButtonElement>('[data-open-project]').forEach((btn) =>
    btn.addEventListener('click', () => {
      opener = btn;
      project = Number(btn.dataset.openProject);
      show(0);
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    }),
  );

  dialog.querySelectorAll('[data-lb-prev]').forEach((b) => b.addEventListener('click', () => show(index - 1)));
  dialog.querySelectorAll('[data-lb-next]').forEach((b) => b.addEventListener('click', () => show(index + 1)));
  dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());

  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });
  // Click on the dark backdrop area (not the image or controls) closes.
  dialog.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target === dialog || target.tagName === 'FIGURE' || target.parentElement === dialog) dialog.close();
  });
  dialog.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    opener?.focus();
  });

  // Swipe on touch devices.
  let startX = 0;
  dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
  dialog.addEventListener(
    'touchend',
    (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    },
    { passive: true },
  );
</script>
