---
import { company } from '../data/site';
import Icon from './Icon.astro';
---

<div
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-white/10 bg-navy-950 pb-[env(safe-area-inset-bottom)] shadow-[0_-10px_30px_-12px_rgb(0_0_0/0.5)] lg:hidden"
  role="region"
  aria-label="Quick contact"
>
  <a
    href={`tel:${company.phoneE164}`}
    class="flex h-16 items-center justify-center gap-2.5 font-display text-lg font-semibold tracking-[0.1em] text-white uppercase transition-colors active:bg-white/10"
  >
    <Icon name="phone" class="size-5 text-accent" />
    Call
  </a>
  <a
    href="#estimate"
    class="flex h-16 items-center justify-center gap-2.5 bg-accent font-display text-lg font-semibold tracking-[0.1em] text-navy-950 uppercase transition-colors active:bg-accent-400"
  >
    <Icon name="clipboard" class="size-5" />
    Free Estimate
  </a>
</div>
