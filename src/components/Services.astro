---
import { company, services, servicesIntro } from '../data/site';
import Icon from './Icon.astro';
import PlaceholderBadge from './PlaceholderBadge.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="services" aria-labelledby="services-heading" class="relative bg-paper pt-20 pb-24 sm:pt-28 lg:pt-32 lg:pb-36">
  <div class="absolute inset-0 bg-blueprint-ink [mask-image:linear-gradient(to_bottom,transparent,black_30%,black_70%,transparent)]"></div>

  <div class="container-site relative grid gap-12 lg:grid-cols-12 lg:gap-16">
    <!-- Intro column (sticky on desktop) -->
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-32">
        <SectionHeading id="services-heading" eyebrow={servicesIntro.eyebrow} heading={servicesIntro.heading} text={servicesIntro.text} />
        <div class="mt-8 flex flex-col gap-4" data-reveal style="--reveal-delay: 120ms">
          <a href="#estimate" class="btn btn-dark self-start">
            Request a Free Estimate
            <Icon name="arrow" class="btn-arrow" />
          </a>
          <p class="text-sm text-slate-600">
            Or call <a href={`tel:${company.phoneE164}`} class="font-semibold text-navy-900 underline decoration-accent decoration-2 underline-offset-4 hover:decoration-navy-900">{company.phoneDisplay}</a>
          </p>
        </div>
      </div>
    </div>

    <!-- Service cards: two staggered columns on tablet/desktop -->
    <ul class="grid gap-5 sm:grid-cols-2 sm:gap-6 sm:pb-12 lg:col-span-8" role="list">
      {
        services.map((service, i) => (
          <li class="sm:even:translate-y-12" data-reveal style={`--reveal-delay: ${(i % 2) * 90}ms`}>
            <article class="group relative flex h-full flex-col overflow-hidden rounded-[4px] bg-white p-7 shadow-[0_1px_2px_rgb(7_14_26/0.06)] ring-1 ring-navy-900/[0.07] transition duration-300 ease-out hover:-translate-y-1 hover:shadow-[0_24px_50px_-24px_rgb(7_14_26/0.4)] sm:p-8">
              <span class="absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 bg-accent transition-transform duration-500 ease-out group-hover:scale-x-100" />
              <div class="flex items-start justify-between">
                <span class="grid size-14 place-items-center rounded-[3px] bg-navy-900 text-accent transition-colors duration-300 group-hover:bg-accent group-hover:text-navy-950">
                  <Icon name={service.icon} class="size-7" />
                </span>
                <span class="font-display text-5xl leading-none font-bold text-navy-900/[0.08] tabular-nums transition-colors duration-300 group-hover:text-accent/40" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>
              <h3 class="mt-7 font-display text-[1.75rem] leading-none font-bold tracking-wide text-navy-900 uppercase">{service.title}</h3>
              <p class="mt-3 leading-relaxed text-slate-600">{service.description}</p>
              <div class="mt-auto pt-5">
                <PlaceholderBadge show={service.placeholder} />
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
