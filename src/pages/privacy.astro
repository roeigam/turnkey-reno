---
/**
 * Privacy policy. A plain-English general template written for what this site actually does:
 * no cookies, no analytics, the estimate form sent by email via Web3Forms. Not legal advice.
 * Update EFFECTIVE_DATE whenever the text changes.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import { company } from '../data/site';

const EFFECTIVE_DATE = '2026-10-23';
const effective = new Date(`${EFFECTIVE_DATE}T12:00:00`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const { street, suite, city, region, postalCode } = company.address;

const h2 = 'mt-12 font-display text-2xl font-bold tracking-wide text-navy-900 uppercase sm:text-3xl';
const p = 'mt-4 leading-relaxed text-slate-700';
const ul = 'mt-4 space-y-2 pl-5 leading-relaxed text-slate-700 marker:text-accent-700 list-disc';
const link = 'font-medium text-navy-900 underline underline-offset-2 hover:text-accent-700';
---

<BaseLayout
  title={`Privacy Policy | ${company.name}`}
  description={`How ${company.legalName} handles the information you send through the free estimate form: what we collect, how we use it, and how to reach us.`}
  path="/privacy"
>
  <Header />
  <main id="main" tabindex="-1" class="focus:outline-none">
    <section id="top" aria-labelledby="privacy-heading" class="on-dark relative isolate overflow-hidden bg-navy-950 text-white">
      <div class="absolute inset-0 -z-10 bg-blueprint [mask-image:linear-gradient(100deg,black_10%,transparent_75%)]"></div>
      <div class="container-site py-16 sm:py-20 lg:py-24">
        <p class="eyebrow text-accent">{company.name}</p>
        <h1 id="privacy-heading" class="mt-5 font-display text-5xl leading-[0.95] font-bold tracking-tight uppercase sm:text-6xl lg:text-7xl">
          Privacy Policy
        </h1>
        <p class="mt-5 text-slate-300">Effective {effective}</p>
      </div>
      <div class="h-1.5 bg-stripes opacity-90" aria-hidden="true"></div>
    </section>

    <article class="bg-white py-14 sm:py-20">
      <div class="container-site">
        <div class="max-w-[65ch] text-lg">
          <p class="leading-relaxed text-slate-700">
            This policy explains what information {company.legalName} ("we") collects through this website, how we use it, and how
            to reach us about it. We keep it short because we collect very little.
          </p>

          <h2 class={h2}>What we collect</h2>
          <p class={p}>When you request a free estimate with the form on this site, we receive what you enter:</p>
          <ul class={ul}>
            <li>your name and phone number;</li>
            <li>your email address, if you give one;</li>
            <li>the property zip code;</li>
            <li>whether you are a homeowner or a real estate investor, if you choose one;</li>
            <li>the service you need and your estimated budget, if you choose one;</li>
            <li>anything you write in the message box.</li>
          </ul>
          <p class={p}>If you call or email us instead, we receive whatever you share with us that way.</p>

          <h2 class={h2}>How it reaches us</h2>
          <p class={p}>
            The form is delivered by <a href="https://web3forms.com" class={link} rel="noopener">Web3Forms</a>, a form service that
            sends your request to our business email inbox. We don't store form submissions on this website.
          </p>

          <h2 class={h2}>How we use it</h2>
          <p class={p}>
            Only to respond to your request: to contact you, talk through your project and prepare your estimate. We don't add you to
            a mailing list.
          </p>

          <h2 class={h2}>Who we share it with</h2>
          <p class={p}>
            We do not sell your information, and we don't share it with anyone for marketing. It passes only through the services
            that make this possible: Web3Forms (form delivery), our email provider, and our website host.
          </p>

          <h2 class={h2}>Cookies and analytics</h2>
          <p class={p}>
            This website does not use cookies, analytics or advertising trackers. Like any website, our host (Netlify) processes
            basic technical information, such as your IP address and browser type, to deliver the pages and keep the site secure.
          </p>

          <h2 class={h2}>How long we keep it, and your choices</h2>
          <p class={p}>
            We keep your request for as long as we need it to respond and for our normal business records. You can ask us at any
            time to see, correct or delete the information you sent us.
          </p>

          <h2 class={h2}>Children</h2>
          <p class={p}>This website is not directed at children under 13, and we don't knowingly collect information from them.</p>

          <h2 class={h2}>Changes to this policy</h2>
          <p class={p}>If we change this policy, we'll update it on this page and change the effective date at the top.</p>

          <h2 class={h2}>Contact us</h2>
          <p class={p}>Questions or requests about your information:</p>
          <ul class="mt-4 space-y-2 leading-relaxed text-slate-700">
            <li>Email: <a href={`mailto:${company.email}`} class={link}>{company.email}</a></li>
            <li>Phone: <a href={`tel:${company.phoneE164}`} class={link}>{company.phoneDisplay}</a></li>
            <li>
              Mail: {company.legalName}, {street}{suite && `, ${suite}`}, {city}, {region} {postalCode}
            </li>
          </ul>

          <p class="mt-14">
            <a href="/" class="btn btn-dark">Back to home</a>
          </p>
        </div>
      </div>
    </article>
  </main>
  <Footer />
  <MobileActionBar />
</BaseLayout>
